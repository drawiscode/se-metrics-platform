# DevInsight 后端配置文件
# 复制本文件为 config.env 并填入实际值: cp config.env.example config.env
#
# 快速开始：
#   1. 复制本文件为 config.env
#   2. 填写必填项：GITHUB_TOKEN, LLM_API_KEY, EMBEDDING_API_KEY
#   3. 双击 start.bat 启动（Windows）或 ./start.sh（Linux/Mac）

# SQLite 数据库文件路径（相对路径，相对于程序启动目录）
DEVINSIGHT_DB=./data/devinsight.db

# 服务端口
PORT=8080

# GitHub Personal Access Token（必填，用于从 GitHub API 同步仓库数据）
# 获取地址：https://github.com/settings/tokens
GITHUB_TOKEN=请填写你的GitHub Personal Access Token

# ---- AI 模块配置（必填）----
# LLM API 地址（兼容 OpenAI Chat Completions 格式）
# DeepSeek:  https://api.deepseek.com
# OpenAI:    https://api.openai.com
LLM_API_BASE=https://api.deepseek.com

# LLM API Key（必填）
# DeepSeek 获取：https://platform.deepseek.com/api_keys
LLM_API_KEY=请填写你的DeepSeek API Key

# 模型名称
LLM_MODEL=deepseek-chat

# ---- Embedding 向量检索配置（必填，用于代码索引和知识库）----
# Embedding API 地址
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding API Key（必填）
# 阿里云获取：https://dashscope.console.aliyun.com/apiKey
EMBEDDING_API_KEY=请填写你的阿里云Embedding API Key

# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-v3

# Embedding 批量生成失败时的重试参数（建议保留默认）
# 常见失败原因是网络/SSL 抖动或服务端限流；重试可显著降低漏生成
EMBEDDING_RETRY_TIMES=3
EMBEDDING_RETRY_BACKOFF_MS=500
EMBEDDING_RETRY_BACKOFF_MAX_MS=4000

# ---- 2.2 代码质量分析配置（可选）----
# 外部工具路径（未配置时默认使用 PATH 中的系统变量 clang-tidy/cppcheck 路径）
CLANG_TIDY_BIN=clang-tidy
CPPCHECK_BIN=cppcheck
CPPLINT_BIN=cpplint
FLAWFINDER_BIN=flawfinder

# Tools expanded when request tools=all. Keep optional tools out unless installed.
QUALITY_ALL_TOOLS=cppcheck,clang-tidy

# Ignore third-party/generated files from quality scoring.
QUALITY_IGNORE_PATHS=backend/src/httplib.h,src/httplib.h

#拉取 GitHub 仓库代码到本地的缓存目录
REPO_CLONE_ROOT=./data/repo_cache

# clang-tidy 需要 compile_commands.json 所在目录（可选）
CLANG_TIDY_COMPILE_COMMANDS=

# clang-tidy 额外参数（可选）
CLANG_TIDY_ARGS=

# If compile_commands.json is missing, generate a lightweight fallback database for clang-tidy.
CLANG_TIDY_FALLBACK_COMPILE_COMMANDS=true
CLANG_TIDY_FALLBACK_COMPILER=clang++
CLANG_TIDY_FALLBACK_ARGS=-std=c++17

# Optional analyzers.
CPPLINT_ARGS=
FLAWFINDER_ARGS=--quiet

# 静态分析输出目录（cppcheck xml 输出）
QUALITY_OUTPUT_DIR=./data/quality

# ---- 日志子系统配置 ----
LOG_LEVEL=info
LOG_FILE=./data/log/devinsight.log
LOG_TO_DB=1
LOG_TO_CONSOLE=1
LOG_RETENTION_DAYS=30
